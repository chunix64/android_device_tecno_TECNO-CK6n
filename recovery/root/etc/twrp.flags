# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
# mount point		fs		device						device2			 device3			flags

# Boot partitions
/boot                     emmc      /dev/block/by-name/boot              flags=display=boot;slotselect;backup;flashimg
/vendor_boot              emmc      /dev/block/by-name/vendor_boot       flags=display=vendor_boot;slotselect;backup;flashimg
/vbmeta                   emmc      /dev/block/by-name/vbmeta            flags=display=vbmeta;backup;flashimg
/vbmeta_system            emmc      /dev/block/by-name/vbmeta_system     flags=display=vbmeta_system;slotselect;backup;flashimg
/vbmeta_vendor            emmc      /dev/block/by-name/vbmeta_vendor     flags=display=vbmeta_vendor;slotselect;backup;flashimg

# Firmware
/dtbo                     emmc      /dev/block/by-name/dtbo              flags=display=dtbo;slotselect;backup
/metadata                 ext4      /dev/block/by-name/md_udc            flags=display=metadata;backup
/misc                     emmc      /dev/block/by-name/misc              flags=display=misc;backup

# Sensitive Data
/persistent               emmc      /dev/block/by-name/frp               flags=display=persistent;backup

# IMEI and modem related
/mnt/vendor/persist       ext4      /dev/block/by-name/persist           flags=display=persist;backup;flashimg
/mnt/vendor/protect_f     ext4      /dev/block/by-name/protect1          flags=display=protect_f;backup;flashimg
/mnt/vendor/protect_s     ext4      /dev/block/by-name/protect2          flags=display=protect_s;backup;flashimg
/mnt/vendor/nvdata        ext4      /dev/block/by-name/nvdata            flags=display=nvdata;backup;flashimg
/mnt/vendor/nvcfg         ext4      /dev/block/by-name/nvcfg             flags=display=nvcfg;backup;flashimg
/nvram         emmc      /dev/block/by-name/nvram             flags=display=nvram;backup

# Standard Mediatek partitions
/expdb                    emmc      /dev/block/by-name/expdb             flags=display=expdb;backup
/logo                     emmc      /dev/block/by-name/logo              flags=display=logo;slotselect;backup
/otp                      emmc      /dev/block/by-name/otp               flags=display=otp;backup
/seccfg                   emmc      /dev/block/by-name/seccfg            flags=display=seccfg;backup
/spmfw                    emmc      /dev/block/by-name/spmfw             flags=display=spmfw;slotselect;backup
/tee1                     emmc      /dev/block/by-name/tee1              flags=display=tee1;backup
/tee2                     emmc      /dev/block/by-name/tee2              flags=display=tee2;backup

# Transsion partition
/tranfs                   ext4      /dev/block/by-name/tranfs            flags=display=tranfs;backup;flashimg

# Firmware / TrustZone / Modem / DSP
/gz1                      emmc      /dev/block/by-name/gz1               flags=display=gz1;backup
/gz2                      emmc      /dev/block/by-name/gz2               flags=display=gz2;backup
/md1dsp                   emmc      /dev/block/by-name/md1dsp            flags=display=md1dsp;backup
/md1img                   emmc      /dev/block/by-name/md1img            flags=display=md1img;backup
/scp1                     emmc      /dev/block/by-name/scp1              flags=display=scp1;backup
/scp2                     emmc      /dev/block/by-name/scp2              flags=display=scp2;backup
/sspm_1                   emmc      /dev/block/by-name/sspm_1            flags=display=sspm_1;backup
/sspm_2                   emmc      /dev/block/by-name/sspm_2            flags=display=sspm_2;backup

# Bootloader / Security / Device info
/boot_para                emmc      /dev/block/by-name/boot_para         flags=display=boot_para;backup
/bootloader               emmc      /dev/block/by-name/lk                flags=display=bootloader;backup
/bootloader2              emmc      /dev/block/by-name/lk2               flags=display=bootloader2;backup
/para                     emmc      /dev/block/by-name/para              flags=display=para;backup
/proinfo                  emmc      /dev/block/by-name/proinfo           flags=display=proinfo;backup
/tkv                      emmc      /dev/block/by-name/tkv               flags=display=tkv;backup

# External storage
/external_sd	vfat		/dev/block/mmcblk0p1	/dev/block/mmcblk0	flags=display="MicroSD Card 1";storage;wipeingui;removable
/external_sd    vfat        /dev/block/mmcblk1p1	/dev/block/mmcblk1 	flags=display="MicroSD Card 2";storage;wipeingui;removable
/external_sd	auto		/dev/block/mmcblk0p1	/dev/block/mmcblk0	flags=display="MicroSD Card 3";storage;wipeingui;removable
/external_sd    auto        /dev/block/mmcblk1p1	/dev/block/mmcblk1 	flags=display="MicroSD Card 4";storage;wipeingui;removable
# auto                      auto      /devices/platform/11240000.mmc*      flags=display=auto;backup;flashimg

# Flashable logical partitions
/super_image        emmc    /dev/block/by-name/super                    flags=display="Super Image";backup 
/system_image		    emmc		/dev/block/by-name/system									  flags=display="System Image";backup;slotselect;flashimg
/vendor_image		    emmc		/dev/block/by-name/vendor									  flags=display="Vendor Image";backup;slotselect;flashimg
/system_ext_image	  emmc		/dev/block/by-name/system_ext								flags=display="System_EXT Image";backup;slotselect;flashimg
/product_image		  emmc		/dev/block/by-name/product									flags=display="Product Image";backup;slotselect;flashimg

# Logical dynamic partitions (erofs)
/system                   erofs     system                               flags=display=system;logical;slotselect;backup;flashimg
/system_ext               erofs     system_ext                           flags=display=system_ext;logical;slotselect;backup;flashimg
/vendor                   erofs     vendor                               flags=display=vendor;logical;slotselect;backup;flashimg
/product                  erofs     product                              flags=display=product;logical;slotselect;backup;flashimg

# # Logical dynamic partitions (ext4)
# /system                   ext4      system                               flags=display=system;logical;slotselect;backup;flashimg
# /system_ext               ext4      system_ext                           flags=display=system_ext;logical;slotselect;backup;flashimg
# /vendor                   ext4      vendor                               flags=display=vendor;logical;slotselect;backup;flashimg
# /product                  ext4      product                              flags=display=product;logical;slotselect;backup;flashimg


# Data
/data                     f2fs      /dev/block/by-name/userdata          flags=display=data;backup;flashimg


